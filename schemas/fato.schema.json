{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-lab-case3.invalid/schemas/fato.schema.json",
  "title": "Fatos do contrato do time (docs/TAREFAS.md, \"Contrato de dados\")",
  "description": "Lista de fatos de metricas/<slug>_<tri>_{itr,apresentacao}_*.json. Escolhido quando os itens têm 'chave'. Campos não listados são permitidos (o contrato diz que campos novos são ignorados). A conferência contra o PDF é do verificar_numeros.py.",
  "type": "array",
  "minItems": 1,
  "items": {"$ref": "#/$defs/fato"},
  "$defs": {
    "fato": {
      "type": "object",
      "required": ["chave", "metrica", "empresa", "documento", "pagina", "trecho"],
      "properties": {
        "chave": {"type": "string", "pattern": "^[a-z0-9_]+$", "description": "Chave do catálogo de fatos (docs/TAREFAS.md)."},
        "metrica": {"type": "string", "minLength": 1, "description": "Nome legível; o verificador imprime este campo."},
        "empresa": {"type": "string", "pattern": "^[a-z0-9_]+$", "description": "slug: minúsculo, sem acento."},
        "documento": {"enum": ["itr", "apresentacao"]},
        "documento_id": {"type": "string", "minLength": 1},
        "data_documento": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "escopo": {"type": "string", "pattern": "^(consolidado|segmento:[a-z0-9_]+)$", "description": "Nunca controladora/holding."},
        "tipo": {"enum": ["fluxo", "saldo"]},
        "periodo": {"type": "string", "pattern": "^([1-4]T|\\d{1,2}M)\\d{2}$", "description": "3T26, 9M26, 4T25..."},
        "periodo_inicio": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "null em saldos (tipo saldo)."},
        "periodo_fim": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "unidade": {"enum": ["R$ mil", "R$ milhões", "R$ bilhões", "mil t", "mil t/ano", "R$/t", "US$/t", "%", "x"], "description": "Como aparece no documento; conversão só em código."},
        "moeda": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "criterio": {"enum": ["contabil", "ajustado"]},
        "valor": {"type": "number"},
        "valor_como_aparece": {"type": "string", "minLength": 1},
        "anterior": {"type": "number"},
        "anterior_como_aparece": {"type": "string", "minLength": 1},
        "variacao_pct": {"type": "number"},
        "pagina": {"type": "integer", "minimum": 1, "description": "Índice do PDF a partir de 1."},
        "trecho": {"type": "string", "minLength": 1, "description": "Cópia literal de pagina_NN.txt."},
        "codigo_cvm": {"type": "string", "pattern": "^\\d+(\\.\\d+)*$"},
        "evidencia": {"type": "object"},
        "revisao_manual": {
          "type": "object",
          "required": ["por", "nota"],
          "properties": {"por": {"type": "string", "minLength": 1}, "nota": {"type": "string", "minLength": 1}}
        }
      },
      "if": {"properties": {"chave": {"const": "qualitativo"}}},
      "then": {"required": ["tema", "resumo"]},
      "else": {"required": ["escopo", "periodo", "unidade", "valor", "valor_como_aparece"]}
    }
  }
}
